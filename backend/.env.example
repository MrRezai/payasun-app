# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payasun_db

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d

# ─── MeliPayamak SMS Gateway (Console API v2) ───────────
# MeliPayamak Console API Key / Secret Token
MELIPAYAMAK_API_KEY=973eab79007b472d8ff7c9f71e5cb86a

# Dedicated Pattern ID (Body ID) for OTP Verification SMS
MELIPAYAMAK_OTP_BODY_ID=524

# Default/Fallback Pattern ID for general SMS
MELIPAYAMAK_BODY_ID=524

# Sender line number for simple notification SMS (e.g., 50001234)
MELIPAYAMAK_FROM_NUMBER=5000123456

# ─── SMS Debug Mode ──────────────────────────────────────
# Set to 'true' in production to dispatch actual SMS messages.
# When 'false', OTP codes are logged to the console and returned
# in the send-otp API response for local testing.
SMS_ENABLED=false
# ─── Application ─────────────────────────────────────────
APP_PORT=3000

# ─── Admin Credentials ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
