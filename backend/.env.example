# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payasun_db

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d

# ─── MeliPayamak SMS Gateway (BaseServiceNumber / Pattern REST API) ───
# Panel username, password, and pattern Body IDs
MELIPAYAMAK_USERNAME=your_username
MELIPAYAMAK_PASSWORD=your_password

# Dedicated Pattern ID (Body ID) for OTP Verification SMS
MELIPAYAMAK_OTP_BODY_ID=12345

# Default/Fallback Pattern ID for general SMS
MELIPAYAMAK_BODY_ID=12345

# ─── SMS Debug Mode ──────────────────────────────────────
# Set to 'true' in production to dispatch actual SMS messages.
# When 'false', OTP codes are logged to the console and returned
# in the send-otp API response for local testing.
SMS_ENABLED=false
# ─── Application ─────────────────────────────────────────
APP_PORT=3000

# ─── Admin Credentials ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
